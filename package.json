{
  "name": "aimo-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @aimo/api start",
    "start:demo": "pnpm --filter @aimo/api start:demo",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @aimo/api seed",
    "seed:demo": "pnpm --filter @aimo/api seed --profile hotel",
    "fixtures:record": "pnpm --filter @aimo/api fixtures:record",
    "agent:demo": "pnpm --filter @aimo/api agent:demo"
  }
}
